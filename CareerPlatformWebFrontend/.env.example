# Career Platform Web Frontend - Environment Variables (example)
# Copy to .env and set as needed.

# In development (npm start), a CRA dev proxy is configured in package.json to forward /api/v1 to http://localhost:3001
# so you typically do NOT need to set REACT_APP_API_URL.
# For production builds (npm run build) or when not using the proxy, set the backend URL explicitly:
REACT_APP_API_URL=http://localhost:3001/api/v1
