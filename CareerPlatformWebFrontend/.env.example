# Frontend .env example
# Copy this file to .env (or .env.development.local) and adjust values as needed.

# Backend API base (frontend accepts any ONE of these; REACT_APP_API_URL is preferred).
# If the value does not end with /api/v1 the app will append /api/v1 automatically.
# Examples:
#   REACT_APP_API_URL=http://localhost:3001           -> calls http://localhost:3001/api/v1/...
#   REACT_APP_API_URL=https://api.example.com/api/v1  -> calls https://api.example.com/api/v1/...
REACT_APP_API_URL=
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=

# Frontend runtime config (optional)
REACT_APP_FRONTEND_URL=http://localhost:3000
REACT_APP_WS_URL=

# Environment flags (optional)
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=true
REACT_APP_ENABLE_SOURCE_MAPS=true

# Dev server options (optional; Create React App honors PORT; HOST is set by package.json)
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=true

# Logging and health (optional)
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/health

# Feature flags (optional JSON or comma-separated)
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false
