# Example environment for local development and preview/proxy environments

# IMPORTANT: These two variables ensure the CRA dev server accepts non-localhost hosts
# used by tunnels, cloud IDE previews, or reverse proxies.
HOST=0.0.0.0
# Only for development. Do NOT enable this in production builds.
DANGEROUSLY_DISABLE_HOST_CHECK=true

# Port configuration (CRA reads PORT)
PORT=3000

# If you need the dev server to run over HTTPS locally, set HTTPS=true (requires certs)
# HTTPS=false

# Frontend base URL (informational for your setup/tools; not used by CRA itself)
REACT_APP_FRONTEND_URL=http://localhost:3000

# Backend API base (the frontend will append /api/v1 automatically if missing)
# If not provided, frontend falls back to relative "/api/v1" using CRA proxy in dev.
REACT_APP_API_URL=http://localhost:3001

# Optional compatibility variables (not strictly required by the current code)
REACT_APP_API_BASE=/api/v1
REACT_APP_BACKEND_URL=http://localhost:3001
REACT_APP_WS_URL=ws://localhost:3001
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=true
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/api/v1/health
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false
