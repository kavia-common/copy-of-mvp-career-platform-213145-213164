# Frontend environment configuration (Create React App)
# NOTE: Do not wrap values in quotes. Adjust to your environment.

# Preferred way to set backend base. Either with or without /api/v1 is fine;
# the app will normalize it to always call the versioned API.
# Examples:
#   http://localhost:3001
#   https://api.example.com/api/v1
REACT_APP_API_URL=http://localhost:3001

# Alternative env names also recognized by the app (leave empty if not used)
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=

# Optional: public URL of this frontend (used in some deployments)
REACT_APP_FRONTEND_URL=http://localhost:3000

# Optional: WebSocket URL (not used in MVP, reserved for future features)
REACT_APP_WS_URL=

# Build/runtime options
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=true
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=true
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/health

# Feature flags (JSON or simple values as needed)
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false
