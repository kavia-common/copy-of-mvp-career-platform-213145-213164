# Frontend environment variables for Career Platform Web Frontend
# NOTE:
# - You can leave these unset in development and rely on CRA proxy (package.json "proxy": "http://localhost:3001").
# - If you set REACT_APP_API_URL/REACT_APP_API_BASE/REACT_APP_BACKEND_URL, do NOT include /api/v1 unless you intend to.
#   The app will normalize and append /api/v1 only if it is not present, avoiding double-prefixing.

# Preferred: backend origin (app will append /api/v1 automatically if missing)
# Examples:
#   http://localhost:3001           -> calls http://localhost:3001/api/v1/...
#   https://backend.example.com     -> calls https://backend.example.com/api/v1/...
#   https://api.example.com/api/v1  -> calls https://api.example.com/api/v1/...
REACT_APP_API_URL=http://localhost:3001

# Alternative env names supported by the app (use ONLY one of these three)
# REACT_APP_API_BASE=
# REACT_APP_BACKEND_URL=

# Optional extras (not required for the MVP)
# REACT_APP_FRONTEND_URL=http://localhost:3000
# REACT_APP_WS_URL=
# REACT_APP_NODE_ENV=development
# REACT_APP_ENABLE_SOURCE_MAPS=true
# REACT_APP_PORT=3000
# REACT_APP_TRUST_PROXY=true
# REACT_APP_LOG_LEVEL=info
# REACT_APP_HEALTHCHECK_PATH=/health
# REACT_APP_FEATURE_FLAGS=
# REACT_APP_EXPERIMENTS_ENABLED=false
